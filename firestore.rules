rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /dailyXConfig/taskPrompts {
      allow get: if request.auth != null;
      allow list, write: if false;
    }
    match /dailyXConfig/analysisPrompts {
      allow get: if request.auth != null;
      allow list, write: if false;
    }
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function record(d) {
      return d.keys().hasOnly(['schemaVersion','key','kind','content','hash'])
        && d.schemaVersion == 1 && d.kind in ['journal','note']
        && d.key is string && d.key.size() > 0 && d.key.size() <= 500
        && d.key.matches('^' + d.kind + ':.+$')
        && d.content is string && d.content.size() > 0 && d.content.size() <= 700000
        && d.hash is string && d.hash.matches('^[a-f0-9]{64}$');
    }
    // Standalone DailyX project rules. Merge this block into an existing project's
    // rules explicitly; never replace the dAIly production rules with this file.
    match /users/{uid}/dailyXRecords/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && record(request.resource.data)
        && request.resource.data.key != 'note:companion/push-service.json';
      allow update: if owner(uid) && record(request.resource.data)
        && request.resource.data.key == resource.data.key
        && request.resource.data.kind == resource.data.kind
        && resource.data.key != 'note:companion/push-service.json'
        && (!(resource.data.key.matches('^note:dailyx/(chunks|receipts)/.*$'))
          || request.resource.data == resource.data);
      allow delete: if owner(uid);
      match /versions/{hash} {
        allow read: if owner(uid);
        allow create: if owner(uid) && request.resource.data.hash == hash
          && request.resource.data == get(/databases/$(database)/documents/users/$(uid)/dailyXRecords/$(id)).data;
        allow update: if owner(uid) && request.resource.data == resource.data;
        allow delete: if owner(uid);
      }
    }
    match /users/{uid}/dailyXRequests/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if false;
    }
    match /users/{uid}/dailyXPushDevices/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['schemaVersion','transport','token','environment','enabled','updatedAt','expiresAt'])
        && request.resource.data.schemaVersion == 1 && request.resource.data.transport == 'apns'
        && request.resource.data.token is string && request.resource.data.token.matches('^[a-f0-9]{32,256}$')
        && request.resource.data.environment in ['development','production'] && request.resource.data.enabled is bool
        && request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 30
        && request.resource.data.expiresAt is string && request.resource.data.expiresAt.size() <= 30;
    }
    match /users/{uid}/dailyXPushDeliveries/{id} { allow read, delete: if owner(uid); allow create, update: if false; }
    match /users/{uid}/dailyXPushBudgets/{id} { allow read, delete: if owner(uid); allow create, update: if false; }
  }
}
