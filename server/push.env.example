DAILYX_FIREBASE_PROJECT_ID=your-project-id
DAILYX_FIREBASE_UID=your-firebase-uid
DAILYX_APNS_TEAM_ID=YOURTEAMID
DAILYX_APNS_KEY_ID=YOURKEY_ID
DAILYX_APNS_KEY_PATH=/run/secrets/apns.p8
# On Google Cloud use workload identity / Application Default Credentials.
# Else mount the Firebase service-account file; never embed it in the image or iOS app.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase.json
